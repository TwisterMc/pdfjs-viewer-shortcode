{
	"name": "twistermc/pdfjs-viewer-shortcode",
	"type": "wordpress-plugin",
	"require": {},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6"
	},
	"scripts": {
		"test": "bash ./scripts/test-php.sh",
		"test:coverage": "vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-text --testdox --colors=always",
		"test:integration": "bash ./scripts/test-wp-integration.sh"
	},
	"autoload": {
		"files": [
			"inc/embed.php",
			"inc/external-domains.php",
			"inc/render-viewer.php",
			"inc/shortcode.php",
			"inc/gutenberg-block.php",
			"inc/media-button.php",
			"inc/options-page.php"
		]
	}
}
