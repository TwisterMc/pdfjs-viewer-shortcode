<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" 
         colors="true"
         verbose="true"
         beStrictAboutOutputDuringTests="false">
  <testsuites>
    <testsuite name="Plugin Tests">
      <directory suffix="Test.php">tests</directory>
    </testsuite>
  </testsuites>
</phpunit>
